# Copy to deploy/undertow.env on the host. Keep real values in the secret store, not in git.
POSTGRES_PASSWORD=
PUBLIC_URL=https://undertow.example
# Address the API listens on for the edge proxy. Default 127.0.0.1:8787 (edge on the same host).
UNDERTOW_BIND=
AUTH_SECRET=
TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SMTP_URL=
MAIL_FROM="Undertow <no-reply@undertow.example>"

# Cloud rendering. The API and worker share WORKER_SECRET (openssl rand -hex 24).
WORKER_SECRET=
RENDER_OUTPUT_DAYS=7
