# Copy to server/.env for local development. Never commit real secrets.
DATABASE_URL=postgres://undertow:undertow@127.0.0.1:5433/undertow
PORT=8787
# Public origin the browser uses. In development the Vite server proxies /v1 to this API,
# so this is the Vite origin.
PUBLIC_URL=http://localhost:5173
# 32+ random bytes, e.g. `openssl rand -base64 32`
AUTH_SECRET=change-me
# Extra origins allowed to call the API with cookies (comma separated)
TRUSTED_ORIGINS=http://localhost:5173

# OAuth. Leave empty to disable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Outgoing mail for password reset and verification. Leave SMTP_URL empty in development:
# emails are printed to the API log instead.
SMTP_URL=
MAIL_FROM="Undertow <no-reply@example.com>"

# Optional: serve the built editor (../dist) from the API for single-container deployments.
STATIC_DIR=

# Cloud rendering. The worker (npm run worker) uses WORKER_SECRET to claim jobs; leave empty to disable.
RENDER_DIR=./data/renders
RENDER_OUTPUT_DAYS=7
WORKER_SECRET=

# Creator billing. Use credentials and identifiers from the same Stripe sandbox.
STRIPE_API_KEY=
STRIPE_CREATOR_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_LIVE_MODE=false
