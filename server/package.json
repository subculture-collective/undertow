{
  "name": "@undertow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Undertow public API: accounts, projects, templates, presets, API keys and rendering",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/db/migrate.js && node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json && cp -R src/data dist/data",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "openapi": "tsx --env-file-if-exists=.env src/scripts/openapi.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "worker:start": "node --env-file-if-exists=.env dist/worker/index.js"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.6",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.7",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.11",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "AGPL-3.0-only"
}
